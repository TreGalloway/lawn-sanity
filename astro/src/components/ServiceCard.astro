---
interface Props {
  name: string;
  description: string;
  icon?: string;
  slug: string;
}

const { name, description, icon, slug } = Astro.props;

const iconMap: Record<string, string> = {
  mower: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 11h5.38a1 1 0 0 1 .9 .55l.72 1.45h5a1 1 0 0 1 1 1v2" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h1.13a1 1 0 0 1 1 .86l1.59 11.14" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 18h-8" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18a2 2 0 1 1 -4 0a2 2 0 0 1 4 0" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 18a2 2 0 1 1 -4 0a2 2 0 0 1 4 0" />`,
  leaf: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 21c.5 -4.5 2.5 -8 7 -10" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18c6.218 0 10.5 -3.288 11 -12v-2h-4.014c-9 0 -11.986 4 -12 9c0 1 0 3 2 5h3l.014 0" />`,
  hedge: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13l-2 -2" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12l2 -2" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21v-13" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.824 16a3 3 0 0 1 -2.743 -3.69a3 3 0 0 1 .304 -4.833a3 3 0 0 1 4.615 -3.707a3 3 0 0 1 4.614 3.707a3 3 0 0 1 .305 4.833a3 3 0 0 1 -2.919 3.695h-4l-.176 -.005" />`,
  spreader: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10a6 6 0 0 0 -6 -6h-3v2a6 6 0 0 0 6 6h3" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14a6 6 0 0 1 6 -6h3v1a6 6 0 0 1 -6 6h-3" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 20l0 -10" />`,
  mulch: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 8v11a1 1 0 0 0 1.806 .591l3.694 -5.091v.055" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 8h15l-3.5 7l-7.1 -.747a4 4 0 0 1 -3.296 -2.493l-2.853 -7.13a1 1 0 0 0 -.928 -.63h-1.323" />`,
  snowflake: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 4l2 1l2 -1" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v6.5l3 1.72" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.928 6.268l.134 2.232l1.866 1.232" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.66 7l-5.629 3.25l.01 3.458" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.928 14.268l-1.866 1.232l-.134 2.232" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.66 17l-5.629 -3.25l-2.99 1.738" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 20l-2 -1l-2 1" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22v-6.5l-3 -1.72" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.072 17.732l-.134 -2.232l-1.866 -1.232" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.34 17l5.629 -3.25l-.01 -3.458" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.072 9.732l1.866 -1.232l.134 -2.232" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.34 7l5.629 3.25l2.99 -1.738" />`,
};

const defaultIcon = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`;
const iconPath = icon ? (iconMap[icon] || defaultIcon) : defaultIcon;
---

<a
  href={`/services/${slug}`}
  class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-primary-200"
>
  <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-primary-500 transition-colors">
    <svg class="w-7 h-7 text-primary-500 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={iconPath} />
  </div>
  <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-500 transition-colors">
    {name}
  </h3>
  <p class="text-gray-600 text-sm line-clamp-2">
    {description}
  </p>
  <div class="mt-4 flex items-center text-primary-500 font-medium text-sm">
    Learn more
    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
