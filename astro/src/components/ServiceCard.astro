---
interface Props {
  name: string;
  description: string;
  icon?: string;
  slug: string;
}

const { name, description, icon, slug } = Astro.props;

const iconMap: Record<string, string> = {
  mower: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10M7 3v4l2 2v6a2 2 0 002 2h2a2 2 0 002-2V9l2-2V3M9 9h6M12 3v1" />`,
  leaf: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 7C14.5 2 9.5 3 9 8c-3 .5-3 5 0 5.5C6 17 8 21 12 21s6-4 3-7.5c3-.5 3-5 0-5.5.2-1.5-1.5-3-3-3.5.5-1 2-1.5 3-1 1 0 2 .5 2 2z" />`,
  hedge: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4-4 2 2 4-6 2 2 4-8" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12h2m4 0h1m3 0h2m4 0h2" />`,
  spreader: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h14M5 4l2 5h10l2-5M5 4v3h14V4M7 9l1 8h8l1-8M10 13h4" />`,
  mulch: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 20h12M12 4v16M9 8h6l-1-4h-4l-1 4zM8 12h8l-1-3H9l-1 3z" />`,
  snowflake: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07" />`,
};

const defaultIcon = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`;
const iconPath = icon ? (iconMap[icon] || defaultIcon) : defaultIcon;
---

<a
  href={`/services/${slug}`}
  class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-primary-200"
>
  <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-primary-500 transition-colors">
    <svg class="w-7 h-7 text-primary-500 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={iconPath} />
  </div>
  <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-500 transition-colors">
    {name}
  </h3>
  <p class="text-gray-600 text-sm line-clamp-2">
    {description}
  </p>
  <div class="mt-4 flex items-center text-primary-500 font-medium text-sm">
    Learn more
    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
